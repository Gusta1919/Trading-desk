{
  "name": "trade-assistant",
  "private": true,
  "version": "1.0.0",
  "description": "A local trading desk for the GOLD Model (XAUUSD): journal, rulebook, check-in, Daily Bias, stats and coach.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c yellow,cyan \"npm run server\" \"npm run web\"",
    "start": "npm run dev",
    "server": "tsx watch server/index.ts",
    "web": "vite",
    "build": "tsc && vite build",
    "open": "open http://localhost:3847",
    "test": "node --import tsx --test tests/*.test.ts",
    "reset": "node --import tsx scripts/reset.ts",
    "preview:build": "node --import tsx scripts/preview/build.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "imapflow": "^2.1.2",
    "lucide-react": "^0.511.0",
    "mailparser": "^3.9.32"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/mailparser": "^3.9.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
