{
  "name": "trade-assistant",
  "private": true,
  "version": "0.2.0",
  "description": "Trade Assistant — lokalna strona tradingowa z bazą SQLite",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c yellow,cyan \"npm run server\" \"npm run web\"",
    "start": "npm run dev",
    "server": "tsx watch server/index.ts",
    "web": "vite",
    "build": "tsc && vite build",
    "open": "open http://localhost:3847"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.5",
    "@fontsource/instrument-serif": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "better-sqlite3": "^11.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "lucide-react": "^0.511.0",
    "recharts": "^2.15.3",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
